#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// WIN は DEF の直上に置く。上のレイヤーが透過したキーを WIN の差し替えで拾うため
#define DEF 0
#define WIN 1
#define NAV 2
#define SYM 3
#define NUM 4
#define ADJ 5

// balanced にするのは、Space や `-` を打鍵中に次のキーと重ねて押しても
// 修飾やレイヤーに化けないようにするため。先に離せばタップとして扱われる
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    // BT の切り替えと同時に OS 用のレイヤーを確定させる。&tog は反転なので、
    // 今の状態に関係なく DEF か WIN だけにする &to を使う
    macros {
        mac_bt: mac_bt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to DEF>;
        };

        win_bt: win_bt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to WIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Mac 用。親指の Cmd はタップで英数／かな。Karabiner の同じ設定とも両立する
        default_layer {
            display-name = "MAIN";
            bindings = <
                &kp TAB          &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &mt LALT MINUS
                &mt LCTRL ESC    &kp A  &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LSHFT        &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                             &mt LGUI LANG2  &lt NAV SPACE  &lt ADJ TAB      &lt SYM RET  &lt NUM BSPC  &mt RGUI LANG1
            >;
        };

        // Windows 用に DEF へ重ねる。Mac の Cmd と同じ親指で Ctrl を押せるようにし、
        // IME は Microsoft IME で無変換＝オフ、変換＝オンに割り当てて使う
        windows_layer {
            display-name = "WIN";
            bindings = <
                &trans           &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &mt LGUI ESC     &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans           &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                             &mt LCTRL INT5  &trans  &trans      &trans  &trans  &mt RCTRL INT4
            >;
        };

        // 左親指の Space 長押し。矢印は Karabiner の fn+hjkl と同じ位置
        nav_layer {
            display-name = "NAV";
            bindings = <
                &none    &none      &none      &none       &none      &none      &kp HOME     &kp PG_DN     &kp PG_UP     &kp END    &kp DEL   &none
                &trans   &kp LALT   &kp LGUI   &kp LSHFT   &kp LCTRL  &none      &kp LEFT     &kp DOWN      &kp UP        &kp RIGHT  &none     &none
                &trans   &none      &none      &none       &none      &none      &kp C_MUTE   &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP   &none     &trans
                                                &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        // 右親指の Enter 長押し。開き括弧は左手、閉じ括弧は右手の同じ指で対になる
        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS   &kp STAR  &kp PIPE  &kp BSLH   &kp TILDE
                &trans     &kp LBRC  &kp LBKT  &kp LPAR  &kp EQUAL  &kp PLUS       &kp UNDER  &kp MINUS  &kp RPAR  &kp RBKT  &kp RBRC   &kp DQT
                &trans     &none     &none     &none     &none      &none          &none      &none      &kp LT    &kp GT    &kp QMARK  &trans
                                                &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };

        // 右親指の Backspace 長押し。左手はテンキー、右手はファンクションキー
        num_layer {
            display-name = "NUM";
            bindings = <
                &none    &kp STAR   &kp N7  &kp N8  &kp N9  &kp MINUS      &none  &kp F7  &kp F8  &kp F9  &kp F10  &none
                &trans   &kp FSLH   &kp N4  &kp N5  &kp N6  &kp PLUS       &none  &kp F4  &kp F5  &kp F6  &kp F11  &none
                &trans   &kp N0     &kp N1  &kp N2  &kp N3  &kp DOT        &none  &kp F1  &kp F2  &kp F3  &kp F12  &trans
                                         &trans  &kp N0  &trans      &trans  &trans  &trans
            >;
        };

        // 左親指の Tab 長押し。BT 1 は Mac、BT 2 は Windows 専用で、切り替えると OS 用のレイヤーも合わせる。
        // USB で Windows に繋ぐときは WIN を手動で切り替える
        adjust_layer {
            display-name = "ADJ";
            bindings = <
                &bootloader   &studio_unlock &none          &none          &none          &none             &none         &none          &none          &none          &studio_unlock &bootloader
                &bt BT_CLR    &mac_bt        &win_bt        &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4      &none         &none          &none          &none          &none          &none
                &sys_reset    &none          &none          &none          &none          &none             &tog WIN      &out OUT_TOG   &none          &none          &none          &sys_reset
                                                            &trans         &trans         &trans            &trans        &trans         &trans
            >;
        };
    };
};
